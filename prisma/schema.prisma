// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Prisma 7 replaced `prisma-client-js` with `prisma-client`, which requires an
// explicit `output` — the client no longer lands in node_modules/.prisma. It is
// generated into the repo so Next's standalone build tracer picks it up (see
// lib/generated/prisma, gitignored). `binaryTargets` is gone with the query
// engine: v7 uses the query compiler, so there is no per-platform binary.
generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

// The connection URL now lives in prisma.config.ts (CLI) and is passed to the
// driver adapter at runtime (lib/db.ts) — v7 datasources no longer take `url`.
datasource db {
  provider = "postgresql"
}

model User {
  id            String         @id @default(uuid())
  username      String         @unique
  passwordHash  String         @map("password_hash")
  isAdmin       Boolean        @default(false) @map("is_admin")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  progress        UserProgress[]
  lists           UserList[]
  refreshTokens   RefreshToken[]
  downloads       UserDownload[]
  deviceTokens    UserDeviceToken[]
  restoreRequests MediaRestoreRequest[]

  @@map("users")
}

model Book {
  id                String      @id @default(uuid())
  asin              String      @unique
  title             String
  description       String?
  publisherSummary  String?     @map("publisher_summary") @db.Text
  runtimeMinutes    Int?        @map("runtime_minutes")
  releaseDate       DateTime?   @map("release_date")
  publisher         String?
  coverUrl          String?     @map("cover_url")
  audioUrl          String?     @map("audio_url")
  metadata          Json?       // Store full metadata JSON
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")

  // Cached S3 Intelligent-Tiering availability for list-view badges ONLY.
  // AVAILABLE | ARCHIVED | RESTORING. Playback/download decisions always do a
  // real-time HeadObject (stream/restore endpoints) — this column may be up to
  // ~24h stale (nightly sync) and self-heals on play. See
  // docs/plans/s3-archive-restore-workflow-v2.md.
  audioAvailability     String    @default("AVAILABLE") @map("audio_availability")
  availabilityCheckedAt DateTime? @map("availability_checked_at")

  // Soft hide: when set, the book is omitted from every list surface (catalog,
  // search, browse + their book counts, library, entity detail pages) but stays
  // fully playable and downloadable by direct link, so anyone mid-book is not
  // cut off. Not a delete — clearing the column restores it everywhere.
  // A timestamp rather than a boolean so we keep *when* it was hidden.
  // See docs/hidden-books.md.
  hiddenAt              DateTime? @map("hidden_at")

  authors           BookAuthor[]
  narrators         BookNarrator[]
  series            BookSeries[]
  categories        BookCategory[]
  chapters          Chapter[]
  progress          UserProgress[]
  listBooks         UserListBook[]
  downloads         UserDownload[]
  restoreRequests   MediaRestoreRequest[]

  @@index([title])
  // Every list query filters on this, so it is worth an index even though the
  // hidden set is expected to stay small.
  @@index([hiddenAt])
  @@map("books")
}

model Chapter {
  id          String  @id @default(uuid())
  bookId      String  @map("book_id")
  chapterNumber Int   @map("chapter_number")
  title       String
  startTime   Float   @map("start_time") // Start time in seconds
  endTime     Float   @map("end_time")   // End time in seconds
  duration    Float   // Duration in seconds
  
  book        Book    @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([bookId, chapterNumber])
  @@index([bookId])
  @@map("chapters")
}

model Author {
  id        String       @id @default(uuid())
  asin      String?      @unique
  name      String       @unique
  createdAt DateTime     @default(now()) @map("created_at")

  books     BookAuthor[]

  @@index([name])
  @@map("authors")
}

model Narrator {
  id        String         @id @default(uuid())
  asin      String?        @unique
  name      String         @unique
  createdAt DateTime       @default(now()) @map("created_at")

  books     BookNarrator[]

  @@index([name])
  @@map("narrators")
}

model Series {
  id        String       @id @default(uuid())
  asin      String?      @unique
  title     String       @unique
  createdAt DateTime     @default(now()) @map("created_at")

  books     BookSeries[]

  @@index([title])
  @@map("series")
}

model Category {
  id        String         @id @default(uuid())
  name      String
  parentId  String?        @map("parent_id")
  level     Int
  createdAt DateTime       @default(now()) @map("created_at")

  parent    Category?      @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children  Category[]     @relation("CategoryHierarchy")
  books     BookCategory[]

  @@unique([name, parentId])
  @@index([name])
  @@index([parentId])
  @@map("categories")
}

// Join Tables

model BookAuthor {
  bookId   String @map("book_id")
  authorId String @map("author_id")

  book     Book   @relation(fields: [bookId], references: [id], onDelete: Cascade)
  author   Author @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@id([bookId, authorId])
  @@map("book_authors")
}

model BookNarrator {
  bookId     String   @map("book_id")
  narratorId String   @map("narrator_id")

  book       Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  narrator   Narrator @relation(fields: [narratorId], references: [id], onDelete: Cascade)

  @@id([bookId, narratorId])
  @@map("book_narrators")
}

model BookSeries {
  bookId   String @map("book_id")
  seriesId String @map("series_id")
  sequence Int?

  book   Book   @relation(fields: [bookId], references: [id], onDelete: Cascade)
  series Series @relation(fields: [seriesId], references: [id], onDelete: Cascade)

  @@id([bookId, seriesId])
  @@index([seriesId, sequence])
  @@map("book_series")
}

model BookCategory {
  bookId     String   @map("book_id")
  categoryId String   @map("category_id")

  book       Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([bookId, categoryId])
  @@map("book_categories")
}

// User Features

model UserProgress {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  bookId          String   @map("book_id")
  positionSeconds Float    @default(0) @map("position_seconds")
  completed       Boolean  @default(false)
  lastPlayed      DateTime @default(now()) @map("last_played")

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  book            Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([userId, bookId])
  @@index([userId, lastPlayed(sort: Desc)])
  @@map("user_progress")
}

model UserList {
  id          String         @id @default(uuid())
  userId      String         @map("user_id")
  name        String
  description String?
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  books       UserListBook[]

  @@index([userId])
  @@map("user_lists")
}

model UserListBook {
  id        String   @id @default(uuid())
  listId    String   @map("list_id")
  bookId    String   @map("book_id")
  addedAt   DateTime @default(now()) @map("added_at")
  position  Int?     // For custom ordering

  list      UserList @relation(fields: [listId], references: [id], onDelete: Cascade)
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([listId, bookId])
  @@index([listId, position])
  @@map("user_list_books")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("refresh_tokens")
}

model UserDownload {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  bookId       String   @map("book_id")
  downloadedAt DateTime @default(now()) @map("downloaded_at")
  deviceId     String?  @map("device_id")

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  book         Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@index([userId, downloadedAt(sort: Desc)])
  @@index([bookId])
  @@map("user_downloads")
}

model MediaRestoreRequest {
  id          String    @id @default(uuid())
  bookId      String    @map("book_id")
  s3Key       String    @map("s3_key")

  status      String    @default("in_progress") // in_progress, completed, failed
  restoreTier String    @default("Standard") @map("restore_tier") // Standard (3-5h); Expedited is a paid test/future option

  requestedAt   DateTime  @default(now()) @map("requested_at")
  completedAt   DateTime? @map("completed_at")
  lastCheckedAt DateTime? @map("last_checked_at")
  errorMessage  String?   @map("error_message")

  // Optional: system-initiated restores have no user; SetNull requires nullable
  requestedByUserId String? @map("requested_by_user_id")

  book        Book  @relation(fields: [bookId], references: [id], onDelete: Cascade)
  requestedBy User? @relation(fields: [requestedByUserId], references: [id], onDelete: SetNull)

  @@index([status, lastCheckedAt])
  @@index([bookId])
  @@index([requestedByUserId])
  @@map("media_restore_requests")
}

model UserDeviceToken {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  deviceToken    String   @map("device_token")
  platform       String   @default("ios") // ios, web (future)
  snsEndpointArn String?  @map("sns_endpoint_arn")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceToken])
  @@index([userId])
  @@map("user_device_tokens")
}
