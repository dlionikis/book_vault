# Example Environment Variables
# Copy this file to .env.local and fill in your values

# Database (matches docker-compose.yml)
DATABASE_URL="postgresql://postgres:dev_password_change_in_production@localhost:5433/book_vault"

# Authentication
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-a-random-secret-here"

# AWS S3 (for production media storage)
# Leave empty for development (uses local filesystem)
S3_BUCKET_NAME=""
S3_REGION="us-east-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# Libation Directory
LIBATION_PATH="/Volumes/BeeDrive/Libation"

# Application
NODE_ENV="development"
PORT=3000
