# Example Environment Variables
# Copy this file to .env.local and fill in your values

# Database (matches docker-compose.yml)
DATABASE_URL="postgresql://postgres:dev_password_change_in_production@localhost:5433/book_vault"

# Authentication
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-a-random-secret-here"

# Mobile Authentication
MOBILE_CORS_ORIGIN="*"  # Lock down in production (e.g., "capacitor://localhost" for Capacitor apps)
JWT_ACCESS_TOKEN_EXPIRY="3600"  # 1 hour in seconds
JWT_REFRESH_TOKEN_EXPIRY="2592000"  # 30 days in seconds

# Test User (created by import script)
TEST_USER_EMAIL="test@example.com"
TEST_USER_PASSWORD="password123"

# AWS S3 (for production media storage)
# Leave empty for development (uses local filesystem)
AWS_S3_BUCKET=""
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_ACCOUNT_ID=""  # Required for admin budget dashboard

# Libation Directory (for data import)
LIBATION_PATH="/Volumes/BeeDrive/Libation"

# Media Data Path (where audiobook files are stored)
# Can be absolute path or relative to project root
# Defaults to "test-data" if not set
MEDIA_DATA_PATH="test-data"
# Example with absolute path:
# MEDIA_DATA_PATH="/Volumes/BeeDrive/Libation"
# Example with custom relative path:
# MEDIA_DATA_PATH="audiobooks"

# Application
NODE_ENV="development"
PORT=3000

# API Base URL (for server-side API calls)
# Leave empty to use default (localhost in dev, VERCEL_URL in prod)
# Set this for custom deployments
NEXT_PUBLIC_API_URL=""
# Example for production: NEXT_PUBLIC_API_URL="https://yourdomain.com"
