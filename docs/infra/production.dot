    // Connections
    internet -> lb_book_vault_alb [label="HTTPS"];
    lb_book_vault_alb -> ecs_book_vault_service [label=":8080"];
    ecs_book_vault_service -> rds_book_vault_db [label=":5432", style=dashed];
    ecs_book_vault_service -> s3_book_vault_media [label="S3 API", style=dashed];

