digraph BookVaultInfra {
    // Graph settings
    rankdir=TB;
    compound=true;
    fontname="Helvetica";
    node [fontname="Helvetica", shape=box, style="filled,rounded"];
    edge [fontname="Helvetica", fontsize=10];
    bgcolor="white";
    label=<<B>Book Vault AWS Infrastructure</B><BR/>    <FONT POINT-SIZE="10">Account: 212477431339 | Region: us-east-1 | Generated: 2026-01-02T09:32:13Z</FONT>>;
    labelloc=t;
    fontsize=16;

    // Internet
    internet [label="Internet\n☁️", shape=ellipse, fillcolor="#E0E0E0"];

    // DNS & Edge
    acm [label="ACM\nSSL Certs", fillcolor="#AF7AC5", shape=box];

    // VPC: vpc-0424cfb25685e00db
    subgraph cluster_vpc_0424cfb25685e00db {
        label=<<B>VPC: vpc-0424cfb25685e00db</B><BR/><FONT POINT-SIZE="10">172.31.0.0/16</FONT>>;
        style="filled,rounded";
        fillcolor="#EBF5FB";
        color="#2980B9";

        subgraph cluster_vpc_0424cfb25685e00db_public {
            label="Public Subnets";
            style="filled,rounded";
            fillcolor="#D5F5E3";
            color="#27AE60";

            lb_book_vault_alb [label="ALB\nbook-vault-alb", fillcolor="#F39C12", shape=box];
            subnet_subnet_0346e88f62cad493b [label="Public-1b\n172.31.80.0/20", fillcolor="#ABEBC6", shape=box, style="filled"];
            subnet_subnet_093f52a651450b860 [label="Public-1d\n172.31.32.0/20", fillcolor="#ABEBC6", shape=box, style="filled"];
            subnet_subnet_00e1355be755bef46 [label="Public-1f\n172.31.64.0/20", fillcolor="#ABEBC6", shape=box, style="filled"];
            more_public [label="... +3 more", shape=plaintext];
        }

        subgraph cluster_vpc_0424cfb25685e00db_private {
            label="Compute Subnets / Compute";
            style="filled,rounded";
            fillcolor="#FCF3CF";
            color="#F39C12";

            ecs_book_vault_service [label="ECS Service\nbook-vault-service\n(2 tasks)", fillcolor="#FF9900", shape=box];
        }

    }

    // Data Stores
    rds_book_vault_db [label="RDS POSTGRES\nbook-vault-db", fillcolor="#3498DB", shape=cylinder];

    // S3 Buckets
