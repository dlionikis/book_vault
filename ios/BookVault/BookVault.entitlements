<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>aps-environment</key>
	<string>development</string>
	<!--
	Declares the app's own keychain access group explicitly. Without this, an app
	launched by the XCUITest runner in the simulator gets no keychain entitlement
	and SecItemAdd fails with -34018 (errSecMissingEntitlement), so login cannot
	persist a session. Normal launches were unaffected, which is why this only
	surfaced once UI tests existed.
	-->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)com.bookvault.BookVault</string>
	</array>
</dict>
</plist>
