<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>aps-environment</key>
	<string>development</string>
	<!--
	Declares the app's own keychain access group explicitly. Without this, an app
	launched by the XCUITest runner in the simulator gets no keychain entitlement
	and SecItemAdd fails with -34018 (errSecMissingEntitlement), so login cannot
	persist a session. Normal launches were unaffected, which is why this only
	surfaced once UI tests existed.
	-->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)com.bookvault.BookVault</string>
	</array>
	<!--
	CarPlay audio (task A4). Granted by Apple against the developer account; the
	App ID must also have the CarPlay Audio capability enabled or signing fails
	with a provisioning-profile mismatch. The simulator cannot satisfy this
	entitlement — it only proves out on a real device.

	The CarPlay scene manifest itself lives in `project.yml`, not here.
	-->
	<key>com.apple.developer.carplay-audio</key>
	<true/>
</dict>
</plist>
