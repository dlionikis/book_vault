{
  "name": "book_vault",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 0.0.0.0",
    "dev:https": "node server.js",
    "build": "next build",
    "start": "next start",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:integration": "JEST_INTEGRATION=true jest __tests__/integration --forceExit",
    "test:all": "JEST_INTEGRATION=true jest --forceExit",
    "test:contract": "node scripts/check-port.js 3000 && concurrently --kill-others --success first \"npm run dev\" \"npm run test:contract:wait\"",
    "test:contract:wait": "wait-on http://localhost:3000 && RUN_CONTRACT_TESTS=true npm test -- __tests__/api",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "e2e:seed": "tsx scripts/seed-e2e.ts",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "type-check": "tsc --noEmit",
    "security:audit": "npm audit --production",
    "security:fix": "npm audit fix",
    "validate": "npm run format:check && npm run lint && npm run type-check && npm run test",
    "validate:web": "./scripts/validate.sh --web",
    "validate:ios": "./scripts/validate.sh --ios",
    "validate:full": "./scripts/validate.sh --all",
    "prepare": "husky",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "./scripts/db-migrate.sh",
    "db:connect": "./scripts/db-connect.sh",
    "db:studio": "prisma studio",
    "db:seed": "tsx scripts/seed-test-user.ts",
    "user:create": "./scripts/create-user.sh",
    "user:reset-password": "./scripts/reset-password.sh",
    "user:delete": "./scripts/delete-user.sh",
    "import": "tsx scripts/import-libation.ts",
    "import:prod": "./scripts/import-prod.sh",
    "api:validate": "redocly lint docs/api/openapi.yaml",
    "api:docs": "redocly build-docs docs/api/openapi.yaml -o docs/api/api-reference.html",
    "api:generate": "npm run api:generate:ts && npm run api:generate:swift",
    "api:generate:ts": "openapi-typescript docs/api/openapi.yaml -o lib/api-types.ts",
    "api:generate:swift": "./scripts/generate-swift.sh",
    "api:watch": "concurrently \"npm run api:watch:ts\" \"npm run api:watch:swift\"",
    "api:watch:ts": "nodemon --watch docs/api/openapi.yaml --exec 'npm run api:generate:ts'",
    "api:watch:swift": "nodemon --watch docs/api/openapi.yaml --exec 'npm run api:generate:swift'",
    "api:check-drift": "npm run api:generate:ts && git diff --exit-code lib/api-types.ts",
    "api:check-drift:swift": "npm run api:generate:swift && git diff --exit-code ios/BookVault/Generated/Models/",
    "api:check-coverage": "tsx scripts/check-endpoint-coverage.ts",
    "docs:generate": "npm run api:generate && npm run api:docs",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "ios:lint": "./scripts/ios-validate.sh --lint-only",
    "ios:build": "./scripts/ios-validate.sh --build-only",
    "ios:test": "./scripts/ios-validate.sh --test-only",
    "ios:test:ui": "./scripts/ios-validate.sh --ui-only",
    "ios:validate": "./scripts/ios-validate.sh",
    "deploy": "./scripts/deploy.sh",
    "deploy:dry-run": "./scripts/deploy.sh --dry-run",
    "deploy:web": "./scripts/deploy.sh --web",
    "deploy:only": "./scripts/deploy.sh --deploy-only",
    "db:firewall:open": "./scripts/db-firewall.sh open",
    "db:firewall:close": "./scripts/db-firewall.sh close",
    "db:firewall:list": "./scripts/db-firewall.sh list"
  },
  "dependencies": {
    "@aws-sdk/client-budgets": "^3.1000.0",
    "@aws-sdk/client-cloudwatch": "^3.1000.0",
    "@aws-sdk/client-cost-explorer": "^3.1000.0",
    "@aws-sdk/client-ecs": "^3.1000.0",
    "@aws-sdk/client-eventbridge": "^3.1091.0",
    "@aws-sdk/client-s3": "^3.958.0",
    "@aws-sdk/client-sns": "^3.1090.0",
    "@aws-sdk/s3-request-presigner": "^3.958.0",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "jose": "^6.1.3",
    "next": "^16.2.11",
    "next-auth": "^4.24.15",
    "next-themes": "^0.4.6",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "recharts": "^3.7.0",
    "sharp": "^0.34.5",
    "turndown": "^7.2.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.3",
    "@playwright/test": "^1.61.1",
    "@redocly/cli": "^2.39.0",
    "@storybook/addon-a11y": "^10.5.2",
    "@storybook/addon-docs": "^10.5.2",
    "@storybook/addon-onboarding": "^10.5.2",
    "@storybook/nextjs": "^10.5.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.9.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/turndown": "^5.0.6",
    "autoprefixer": "^10.4.20",
    "aws-sdk-client-mock": "^4.1.0",
    "concurrently": "^10.0.3",
    "dotenv": "^17.2.3",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.2.10",
    "eslint-plugin-storybook": "^10.5.2",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "jest-mock-extended": "^4.0.0",
    "jest-openapi": "^0.14.2",
    "lint-staged": "^17.1.0",
    "nodemon": "^3.0.2",
    "openapi-typescript": "^7.13.0",
    "postcss": "^8.4.49",
    "prettier": "^3.7.4",
    "prisma": "^6.19.3",
    "storybook": "^10.5.2",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "undici": "^8.7.0",
    "wait-on": "^9.0.10",
    "yaml": "^2.8.2"
  },
  "overrides": {
    "glob": "^11.0.0",
    "test-exclude": "^7.0.1",
    "openapi-validator": {
      "axios": "^1.12.0"
    }
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "prettier --write",
      "eslint --fix --max-warnings=0"
    ],
    "*.{json,md,yaml,yml}": [
      "prettier --write"
    ]
  }
}
